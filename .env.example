# Copy only if you do not already have .env. Never overwrite existing keys.
STOCKFISH_PATH=
LICHESS_API_TOKEN=

# Hosted draft generation: select an exact :free model and one provider slug.
# No default model/provider is selected; availability/pricing must be checked.
COACH_MODEL_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=

# Alternative: set COACH_MODEL_BACKEND=ollama and an installed local model tag.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Grounded prompt budget; use values supported by the selected model/runtime.
COACH_CONTEXT_TOKENS=16384
COACH_MAX_OUTPUT_TOKENS=1500
